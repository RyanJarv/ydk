{
  "name": "ydk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An example why development kit repository that explains why its own code exists.",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "ydk": "./src/launcher.ts"
  },
  "scripts": {
    "ydk": "node src/launcher.ts",
    "serve": "node src/launcher.ts serve",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.32",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.8.0"
  }
}
